<?xml version="1.0"?>
<sdf version="1.8">
  <world name="Autonomous_Target_Tracking_Bot">

    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.6 0.5 0.4 1</ambient>
      <background>0.5 0.5 0.7 1</background>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>1.0 0.6 0.2 1</diffuse>
      <direction>-1 0 -0.2</direction>
    </light>

    <!-- Simulation ground. -->
    <model name="Garden_Dimensions">
      <static>true</static>
      <pose>1.9 2.1 -0.01 0 0 0</pose>

      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <box>
              <size>12 8 0.02</size>
            </box>
          </geometry>

          <!-- Contact filtering only; visuals remain visible to camera/LiDAR. -->
          <surface><contact><collide_bitmask>0xFFFF</collide_bitmask></contact></surface>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <box>
              <size>12 8 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.68 0.65 1</ambient>
            <diffuse>0.65 0.68 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Core Gazebo systems. -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Moving cylinders are updated by moving_obstacle_controller. -->
    <model name="Moving_Cylinder_01">
      <static>true</static>
      <pose>1 4.06746940175069 0.15 0 0 0</pose>
      <link name="obstacle_link">
        <gravity>false</gravity>
        <inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.005</izz></inertia></inertial>
        <collision name="Moving_Cylinder_01_collision">
          <geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry>
          <surface><contact><collide_bitmask>0x01</collide_bitmask></contact></surface>
        </collision>
        <visual name="Moving_Cylinder_01_visual">
          <geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.95 0.15 0.10 1</ambient><diffuse>0.95 0.15 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

