<?xml version="1.0"?>
<sdf version="1.9">
  <model name="Target_AGV">
    <static>false</static>
    <pose>0.4 0.1 0.034 0 0 0</pose>

    <!-- Rectangular Chassis Frame: 200 x 156 x 40 mm (matching imported URDF) -->
    <link name="chassis">
      <inertial>
        <mass>2.266</mass>
        <inertia>
          <ixx>0.00501</ixx>
          <iyy>0.00919</iyy>
          <izz>0.00888</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry><box><size>0.200 0.156 0.040</size></box></geometry>

        <!-- Contact filtering only; visuals remain visible to camera/LiDAR. -->
        <surface><contact><collide_bitmask>0x02</collide_bitmask></contact></surface>
      </collision>
      <visual name="body_visual">
        <geometry><box><size>0.200 0.156 0.040</size></box></geometry>
        <material>
          <ambient>0.25 0.3 0.35 1</ambient>
          <diffuse>0.25 0.3 0.35 1</diffuse>
        </material>
      </visual>

      <!-- Rear panel backing, facing -X mounted at rear face (-0.100 m) -->
      <visual name="checker_backing">
        <pose>-0.1006 0 0.040 0 0 0</pose>
        <geometry><box><size>0.001 0.092 0.062</size></box></geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>

      <!-- 6 columns x 4 rows of 15 mm checker squares.
           Panel width = 90 mm; height = 60 mm. -->
      <visual name="check_0_0"><pose>-0.1013 -0.0375 0.0175 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="check_0_1"><pose>-0.1013 -0.0225 0.0175 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>
      <visual name="check_0_2"><pose>-0.1013 -0.0075 0.0175 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="check_0_3"><pose>-0.1013 0.0075 0.0175 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>
      <visual name="check_0_4"><pose>-0.1013 0.0225 0.0175 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="check_0_5"><pose>-0.1013 0.0375 0.0175 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>

      <visual name="check_1_0"><pose>-0.1013 -0.0375 0.0325 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>
      <visual name="check_1_1"><pose>-0.1013 -0.0225 0.0325 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="check_1_2"><pose>-0.1013 -0.0075 0.0325 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>
      <visual name="check_1_3"><pose>-0.1013 0.0075 0.0325 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="check_1_4"><pose>-0.1013 0.0225 0.0325 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>
      <visual name="check_1_5"><pose>-0.1013 0.0375 0.0325 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>

      <visual name="check_2_0"><pose>-0.1013 -0.0375 0.0475 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="check_2_1"><pose>-0.1013 -0.0225 0.0475 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>
      <visual name="check_2_2"><pose>-0.1013 -0.0075 0.0475 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="check_2_3"><pose>-0.1013 0.0075 0.0475 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>
      <visual name="check_2_4"><pose>-0.1013 0.0225 0.0475 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="check_2_5"><pose>-0.1013 0.0375 0.0475 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>

      <visual name="check_3_0"><pose>-0.1013 -0.0375 0.0625 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>
      <visual name="check_3_1"><pose>-0.1013 -0.0225 0.0625 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="check_3_2"><pose>-0.1013 -0.0075 0.0625 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>
      <visual name="check_3_3"><pose>-0.1013 0.0075 0.0625 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="check_3_4"><pose>-0.1013 0.0225 0.0625 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>
      <visual name="check_3_5"><pose>-0.1013 0.0375 0.0625 0 0 0</pose><geometry><box><size>0.0005 0.015 0.015</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>

      <!-- Optional elevated range sensor for target-observation experiments. -->
      <sensor name="target_lidar" type="gpu_lidar">
        <pose>0 0 0.130 0 0 0</pose>
        <topic>/model/Target_AGV/lidar/scan</topic>
        <update_rate>20</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan><horizontal>
            <samples>360</samples><resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.141592653589793</max_angle>
          </horizontal></scan>
          <range><min>0.05</min><max>6.0</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>

    </link>

    <!-- ==================== REAR WHEELS (Driven) ==================== -->
    <!-- Rear Left Wheel: radius 0.034 m, width 0.018 m, separation 0.181 m -->
    <link name="rear_left_wheel">
      <pose>-0.0523 0.0905 0 0 0 0</pose>
      <inertial>
        <mass>0.0652</mass>
        <inertia>
          <ixx>0.00002065</ixx><iyy>0.00003778</iyy><izz>0.00002065</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.034</radius>
            <length>0.018</length>
          </cylinder>
        </geometry>

        <!-- Contact filtering only; visuals remain visible to camera/LiDAR. -->
        <surface>
          <contact> 
            <collide_bitmask>0x02</collide_bitmask>
          </contact>
        </surface>
      </collision>
      
      <visual name="visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.034</radius><length>0.018</length></cylinder></geometry>
        <material>
          <ambient>0.04 0.04 0.04 1</ambient>
          <diffuse>0.04 0.04 0.04 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rear_left_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>

    <!-- Rear Right Wheel -->
    <link name="rear_right_wheel">
      <pose>-0.0523 -0.0905 0 0 0 0</pose>
      <inertial>
        <mass>0.0652</mass>
        <inertia>
          <ixx>0.00002065</ixx><iyy>0.00003778</iyy><izz>0.00002065</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.034</radius><length>0.018</length></cylinder></geometry>

        <!-- Contact filtering only; visuals remain visible to camera/LiDAR. -->
        <surface><contact><collide_bitmask>0x02</collide_bitmask></contact></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.034</radius><length>0.018</length></cylinder></geometry>
        <material>
          <ambient>0.04 0.04 0.04 1</ambient>
          <diffuse>0.04 0.04 0.04 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rear_right_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>

    <!-- ==================== FRONT STEERING & WHEELS ==================== -->
    <!-- Front Left Steering Knuckle: kingpin width 0.1137 m (Y = +0.05685) -->
    <link name="front_left_knuckle">
      <pose>0.0523 0.05685 0 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.015 0.015 0.020</size></box></geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="front_left_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_knuckle</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.85</lower>
          <upper>0.85</upper>
          <effort>10.0</effort>
          <velocity>2.0</velocity>
        </limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>

    <!-- Front Left Wheel -->
    <link name="front_left_wheel">
      <pose>0.0523 0.0905 0 0 0 0</pose>
      <inertial>
        <mass>0.0652</mass>
        <inertia>
          <ixx>0.00002065</ixx><iyy>0.00003778</iyy><izz>0.00002065</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.034</radius><length>0.018</length></cylinder></geometry>

        <!-- Contact filtering only; visuals remain visible to camera/LiDAR. -->
        <surface><contact><collide_bitmask>0x02</collide_bitmask></contact></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.034</radius><length>0.018</length></cylinder></geometry>
        <material>
          <ambient>0.04 0.04 0.04 1</ambient>
          <diffuse>0.04 0.04 0.04 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_knuckle</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>

    <!-- Front Right Steering Knuckle: kingpin width 0.1137 m (Y = -0.05685) -->
    <link name="front_right_knuckle">
      <pose>0.0523 -0.05685 0 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.015 0.015 0.020</size></box></geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="front_right_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_knuckle</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.85</lower>
          <upper>0.85</upper>
          <effort>10.0</effort>
          <velocity>2.0</velocity>
        </limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>

    <!-- Front Right Wheel -->
    <link name="front_right_wheel">
      <pose>0.0523 -0.0905 0 0 0 0</pose>
      <inertial>
        <mass>0.0652</mass>
        <inertia>
          <ixx>0.00002065</ixx><iyy>0.00003778</iyy><izz>0.00002065</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.034</radius><length>0.018</length></cylinder></geometry>

        <!-- Contact filtering only; visuals remain visible to camera/LiDAR. -->
        <surface><contact><collide_bitmask>0x02</collide_bitmask></contact></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.034</radius><length>0.018</length></cylinder></geometry>
        <material>
          <ambient>0.04 0.04 0.04 1</ambient>
          <diffuse>0.04 0.04 0.04 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_knuckle</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>

    <!-- ==================== PLUGINS ==================== -->
    <!-- Ground Truth Pose Publisher -->
    <plugin
        filename="gz-sim-pose-publisher-system"
        name="gz::sim::systems::PosePublisher">
      <topic>/model/Target_AGV/ground_truth_pose</topic>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <update_frequency>30</update_frequency>
    </plugin>

    <!-- Ackermann Steering System (identical parameters to imported URDF) -->
    <plugin
        filename="gz-sim-ackermann-steering-system"
        name="gz::sim::systems::AckermannSteering">
      <!-- Rear driven wheels -->
      <left_joint>rear_left_joint</left_joint>
      <right_joint>rear_right_joint</right_joint>

      <!-- Front steering knuckle joints -->
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>

      <!-- Dimensions and limits identical to imported URDF -->
      <wheel_base>0.1046</wheel_base>
      <wheel_separation>0.181</wheel_separation>
      <kingpin_width>0.1137</kingpin_width>
      <wheel_radius>0.034</wheel_radius>
      <steering_limit>0.5</steering_limit>

      <min_velocity>-0.20</min_velocity>
      <max_velocity>0.20</max_velocity>

      <topic>/model/Target_AGV/cmd_vel</topic>
      <odom_topic>/model/Target_AGV/odometry</odom_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
