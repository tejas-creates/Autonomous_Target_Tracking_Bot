<?xml version="1.0"?>
<!--
  The Autonomous Backyard - garden version of simulation_world.sdf.
  GENERATED by simulation/garden/build_garden_world.py (do not edit by hand).

  Same world name, operating area (12 x 8 m centred at 1.9, 2.1), obstacle names,
  sizes and start positions as simulation_world.sdf.  Inside the area, every visual is
  either flat on the ground (<= 3 mm) or one of the 27 cylinder obstacles
  (collision r 0.10 m, h 0.30 m).  The hedge (0.55 m) is the LiDAR boundary.
-->
<sdf version="1.9">
  <world name="Autonomous_Target_Tracking_Bot">

    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.45 0.47 0.5 1</ambient>
      <background>0.62 0.76 0.92 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <sky>
        <clouds><speed>0.6</speed><humidity>0.35</humidity><mean_size>0.4</mean_size></clouds>
      </sky>
    </scene>

    <!-- Late-morning sun: ~51 deg elevation, shadows fall north-east (away from the lawn). -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.98 0.94 0.86 1</diffuse>
      <specular>0.18 0.18 0.17 1</specular>
      <intensity>1.0</intensity>
      <direction>0.317893 0.546379 -0.774864</direction>
    </light>

    <!-- Soft sky fill so shaded sides stay visible (no shadows, no specular). -->
    <light name="sky_fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.24 0.27 0.32 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>-0.35 -0.45 -0.82</direction>
    </light>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui><title>3D View</title><property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property></gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.45 0.47 0.5</ambient_light>
        <background_color>0.62 0.76 0.92</background_color>
        <camera_pose>14 -9 8 0 0.445295 2.37729</camera_pose>
        <camera_clip><near>0.05</near><far>400</far></camera_clip>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="EntityContextMenuPlugin"><gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
      <plugin filename="GzSceneManager" name="GzSceneManager"><gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
      <plugin filename="InteractiveViewControl" name="InteractiveViewControl"><gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
      <plugin filename="CameraTracking" name="CameraTracking"><gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
      <plugin filename="MarkerManager" name="MarkerManager"><gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
      <plugin filename="SelectEntities" name="SelectEntities"><gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
      <plugin filename="Spawn" name="Spawn"><gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
      <plugin filename="VisualizationCapabilities" name="VisualizationCapabilities"><gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui><title>World control</title><property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property><property type="double" key="height">72</property>
          <property type="double" key="z">1</property><property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors>
        </gz-gui>
        <play_pause>true</play_pause><step>true</step><start_paused>true</start_paused><use_event>true</use_event>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui><title>World stats</title><property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property><property type="double" key="height">110</property>
          <property type="double" key="width">290</property><property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="right" target="right"/><line own="bottom" target="bottom"/></anchors>
        </gz-gui>
        <sim_time>true</sim_time><real_time>true</real_time><real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
      <plugin filename="ComponentInspector" name="Component inspector">
        <gz-gui><property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property></gz-gui>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui><property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property></gz-gui>
      </plugin>
    </gui>

    <!-- Flat lawn. The 12 x 8 m operating area is the same as in simulation_world.sdf. -->
    <model name="Garden_Ground">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="ground_collision"><pose>1.9 3 -0.01 0 0 0</pose><geometry><box><size>21.4 16.8 0.02</size></box></geometry><surface><contact><collide_bitmask>0xFFFF</collide_bitmask></contact></surface></collision>
        <visual name="lawn"><pose>0 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><mesh><uri>garden/assets/meshes/lawn.obj</uri></mesh></geometry><material><ambient>0.86 1 0.8 1</ambient><diffuse>0.86 1 0.8 1</diffuse><specular>0.06 0.06 0.06 1</specular><pbr><metal><roughness>1.0</roughness><metalness>0.0</metalness><albedo_map>garden/assets/external/ambientcg/Grass004/Grass004_albedo.jpg</albedo_map><normal_map>garden/assets/external/ambientcg/Grass004/Grass004_normal.jpg</normal_map><roughness_map>garden/assets/external/ambientcg/Grass004/Grass004_roughness.jpg</roughness_map></metal></pbr></material></visual>
        <visual name="meadow"><pose>0 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><mesh><uri>garden/assets/meshes/meadow.obj</uri></mesh></geometry><material><ambient>0.78 0.92 0.74 1</ambient><diffuse>0.78 0.92 0.74 1</diffuse><specular>0.06 0.06 0.06 1</specular><pbr><metal><roughness>1.0</roughness><metalness>0.0</metalness><albedo_map>garden/assets/external/ambientcg/Grass004/Grass004_albedo.jpg</albedo_map><normal_map>garden/assets/external/ambientcg/Grass004/Grass004_normal.jpg</normal_map><roughness_map>garden/assets/external/ambientcg/Grass004/Grass004_roughness.jpg</roughness_map></metal></pbr></material></visual>
      </link>
    </model>

    <!-- Visual only, max 3 mm high: no collision, below the LiDAR scan plane. -->
    <model name="Garden_Path">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="gravel"><pose>0 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><mesh><uri>garden/assets/meshes/path_gravel.obj</uri></mesh></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.06 0.06 0.06 1</specular><pbr><metal><roughness>1.0</roughness><metalness>0.0</metalness><albedo_map>garden/assets/external/ambientcg/Gravel022/Gravel022_albedo.jpg</albedo_map><normal_map>garden/assets/external/ambientcg/Gravel022/Gravel022_normal.jpg</normal_map><roughness_map>garden/assets/external/ambientcg/Gravel022/Gravel022_roughness.jpg</roughness_map></metal></pbr></material></visual>
        <visual name="edging"><pose>0 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><mesh><uri>garden/assets/meshes/path_edge.obj</uri></mesh></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.06 0.06 0.06 1</specular><pbr><metal><roughness>1.0</roughness><metalness>0.0</metalness><albedo_map>garden/assets/external/polyhaven/farm_soil/farm_soil_albedo.jpg</albedo_map><normal_map>garden/assets/external/polyhaven/farm_soil/farm_soil_normal.jpg</normal_map><roughness_map>garden/assets/external/polyhaven/farm_soil/farm_soil_roughness.jpg</roughness_map></metal></pbr></material></visual>
        <visual name="stepping_stones"><pose>0 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><mesh><uri>garden/assets/meshes/path_stones.obj</uri></mesh></geometry><material><ambient>0.72 0.72 0.74 1</ambient><diffuse>0.72 0.72 0.74 1</diffuse><specular>0.06 0.06 0.06 1</specular><pbr><metal><roughness>1.0</roughness><metalness>0.0</metalness><albedo_map>garden/assets/external/polyhaven/rock_pitted_mossy/rock_pitted_mossy_albedo.jpg</albedo_map><normal_map>garden/assets/external/polyhaven/rock_pitted_mossy/rock_pitted_mossy_normal.jpg</normal_map><roughness_map>garden/assets/external/polyhaven/rock_pitted_mossy/rock_pitted_mossy_roughness.jpg</roughness_map></metal></pbr></material></visual>
      </link>
    </model>

    <!-- Continuous 0.55 m hedge just outside the operating area (LiDAR boundary). -->
    <model name="Garden_Hedge">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="hedge_collision_0"><pose>1.9 -2.245 0.275 0 0 0</pose><geometry><box><size>13.24 0.55 0.55</size></box></geometry><surface><contact><collide_bitmask>0xFFFF</collide_bitmask></contact></surface></collision>
        <collision name="hedge_collision_1"><pose>1.9 6.445 0.275 0 0 0</pose><geometry><box><size>13.24 0.55 0.55</size></box></geometry><surface><contact><collide_bitmask>0xFFFF</collide_bitmask></contact></surface></collision>
        <collision name="hedge_collision_2"><pose>-4.445 2.1 0.275 0 0 0</pose><geometry><box><size>0.55 8 0.55</size></box></geometry><surface><contact><collide_bitmask>0xFFFF</collide_bitmask></contact></surface></collision>
        <collision name="hedge_collision_3"><pose>8.245 2.1 0.275 0 0 0</pose><geometry><box><size>0.55 8 0.55</size></box></geometry><surface><contact><collide_bitmask>0xFFFF</collide_bitmask></contact></surface></collision>
        <visual name="hedge"><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>garden/assets/meshes/hedge.obj</uri></mesh></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.06 0.06 0.06 1</specular><pbr><metal><roughness>0.85</roughness><metalness>0.0</metalness><albedo_map>garden/assets/textures/hedge_albedo.jpg</albedo_map><normal_map>garden/assets/textures/hedge_normal.jpg</normal_map></metal></pbr></material></visual>
      </link>
    </model>

    <!-- Static obstacle: scanned terracotta bowl with leafy plant on a plinth. Collision r 0.10 h 0.30. -->
    <model name="Static_Cylinder_01">
      <static>true</static>
      <pose>3.5 0 0.15 0 0 1.79657</pose>
      <link name="link">
        <collision name="Static_Cylinder_01_collision"><pose>0 0 0 0 0 0</pose><geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry><surface><contact><collide_bitmask>0x01</collide_bitmask></contact></surface></collision>
        <visual name="plinth"><pose>0 0 -0.15 0 0 0</pose><geometry><mesh><uri>garden/assets/meshes/plinth_potted_plant_01.obj</uri></mesh></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.06 0.06 0.06 1</specular><pbr><metal><roughness>1.0</roughness><metalness>0.0</metalness><albedo_map>garden/assets/external/polyhaven/rough_concrete/rough_concrete_albedo.jpg</albedo_map><normal_map>garden/assets/external/polyhaven/rough_concrete/rough_concrete_normal.jpg</normal_map><roughness_map>garden/assets/external/polyhaven/rough_concrete/rough_concrete_roughness.jpg</roughness_map></metal></pbr></material></visual>
        <visual name="potted_plant"><pose>-1.21817e-08 -1.21817e-08 -0.10253 1.5708 0 0</pose><geometry><mesh><uri>garden/assets/external/polyhaven/potted_plant_01/potted_plant_01.gltf</uri><scale>0.545 0.545 0.545</scale></mesh></geometry></visual>
      </link>
    </model>

    <!-- Static obstacle: scanned white pot with succulent. Collision r 0.10 h 0.30. -->
    <model name="Static_Cylinder_02">
      <static>true</static>
      <pose>3.91647 3.95616 0.15 0 0 0.321523</pose>
      <link name="link">
        <collision name="Static_Cylinder_02_collision"><pose>0 0 0 0 0 0</pose><geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry><surface><contact><collide_bitmask>0x01</collide_bitmask></contact></surface></collision>
        <visual name="plinth"><pose>0 0 -0.15 0 0 0</pose><geometry><mesh><uri>garden/assets/meshes/plinth_potted_plant_04.obj</uri></mesh></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.06 0.06 0.06 1</specular><pbr><metal><roughness>1.0</roughness><metalness>0.0</metalness><albedo_map>garden/assets/external/polyhaven/rough_concrete/rough_concrete_albedo.jpg</albedo_map><normal_map>garden/assets/external/polyhaven/rough_concrete/rough_concrete_normal.jpg</normal_map><roughness_map>garden/assets/external/polyhaven/rough_concrete/rough_concrete_roughness.jpg</roughness_map></metal></pbr></material></visual>
        <visual name="potted_plant"><pose>-5.68107e-09 -0 -0.0455725 1.5708 0 0</pose><geometry><mesh><uri>garden/assets/external/polyhaven/potted_plant_04/potted_plant_04.gltf</uri><scale>1.525 1.525 1.525</scale></mesh></geometry></visual>
      </link>
    </model>

    <!-- Static obstacle: concrete planter with box ball. Collision r 0.10 h 0.30. -->
    <model name="Static_Cylinder_03">
      <static>true</static>
      <pose>5.2958 2.88041 0.15 0 0 -1.6092</pose>
      <link name="link">
        <collision name="Static_Cylinder_03_collision"><pose>0 0 0 0 0 0</pose><geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry><surface><contact><collide_bitmask>0x01</collide_bitmask></contact></surface></collision>
        <visual name="pot"><pose>0 0 -0.15 0 0 0</pose><geometry><mesh><uri>garden/assets/meshes/pot_concrete.obj</uri></mesh></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.06 0.06 0.06 1</specular><pbr><metal><roughness>1.0</roughness><metalness>0.0</metalness><albedo_map>garden/assets/external/polyhaven/rough_concrete/rough_concrete_albedo.jpg</albedo_map><normal_map>garden/assets/external/polyhaven/rough_concrete/rough_concrete_normal.jpg</normal_map><roughness_map>garden/assets/external/polyhaven/rough_concrete/rough_concrete_roughness.jpg</roughness_map></metal></pbr></material></visual>
        <visual name="soil"><pose>0 0 -0.15 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><mesh><uri>garden/assets/meshes/soil_disc.obj</uri></mesh></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.06 0.06 0.06 1</specular><pbr><metal><roughness>1.0</roughness><metalness>0.0</metalness><albedo_map>garden/assets/external/polyhaven/farm_soil/farm_soil_albedo.jpg</albedo_map><normal_map>garden/assets/external/polyhaven/farm_soil/farm_soil_normal.jpg</normal_map><roughness_map>garden/assets/external/polyhaven/farm_soil/farm_soil_roughness.jpg</roughness_map></metal></pbr></material></visual>
        <visual name="topiary"><pose>0 0 -0.15 0 0 0</pose><geometry><mesh><uri>garden/assets/meshes/boxwood.obj</uri></mesh></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.06 0.06 0.06 1</specular><pbr><metal><roughness>0.85</roughness><metalness>0.0</metalness><albedo_map>garden/assets/textures/hedge_albedo.jpg</albedo_map><normal_map>garden/assets/textures/hedge_normal.jpg</normal_map></metal></pbr></material></visual>
      </link>
    </model>

    <!-- Static obstacle: tree stump. Collision r 0.10 h 0.30. -->
    <model name="Static_Cylinder_04">
      <static>true</static>
      <pose>5.2174 0.975037 0.15 0 0 -1.04016</pose>
      <link name="link">
        <collision name="Static_Cylinder_04_collision"><pose>0 0 0 0 0 0</pose><geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry><surface><contact><collide_bitmask>0x01</collide_bitmask></contact></surface></collision>
        <visual name="stump"><pose>0 0 -0.15 0 0 0</pose><geometry><mesh><uri>garden/assets/meshes/stump.obj</uri></mesh></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.06 0.06 0.06 1</specular><pbr><metal><roughness>1.0</roughness><metalness>0.0</metalness><albedo_map>garden/assets/external/polyhaven/bark_brown_02/bark_brown_02_albedo.jpg</albedo_map><normal_map>garden/assets/external/polyhaven/bark_brown_02/bark_brown_02_normal.jpg</normal_map><roughness_map>garden/assets/external/polyhaven/bark_brown_02/bark_brown_02_roughness.jpg</roughness_map></metal></pbr></material></visual>
        <visual name="rings"><pose>0 0 -0.15 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><mesh><uri>garden/assets/meshes/stump_top.obj</uri></mesh></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.06 0.06 0.06 1</specular><pbr><metal><roughness>0.9</roughness><metalness>0.0</metalness><albedo_map>garden/assets/textures/stump_rings.jpg</albedo_map></metal></pbr></material></visual>
      </link>
    </model>

    <!-- Static obstacle: scanned terracotta pot with plant on a plinth. Collision r 0.10 h 0.30. -->
    <model name="Static_Cylinder_05">
      <static>true</static>
      <pose>1.56711 0 0.15 0 0 -1.1392</pose>
      <link name="link">
        <collision name="Static_Cylinder_05_collision"><pose>0 0 0 0 0 0</pose><geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry><surface><contact><collide_bitmask>0x01</collide_bitmask></contact></surface></collision>
        <visual name="plinth"><pose>0 0 -0.15 0 0 0</pose><geometry><mesh><uri>garden/assets/meshes/plinth_potted_plant_02.obj</uri></mesh></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.06 0.06 0.06 1</specular><pbr><metal><roughness>1.0</roughness><metalness>0.0</metalness><albedo_map>garden/assets/external/polyhaven/rough_concrete/rough_concrete_albedo.jpg</albedo_map><normal_map>garden/assets/external/polyhaven/rough_concrete/rough_concrete_normal.jpg</normal_map><roughness_map>garden/assets/external/polyhaven/rough_concrete/rough_concrete_roughness.jpg</roughness_map></metal></pbr></material></visual>
        <visual name="potted_plant"><pose>-0 3.68804e-09 0.0349738 1.5708 0 0</pose><geometry><mesh><uri>garden/assets/external/polyhaven/potted_plant_02/potted_plant_02.gltf</uri><scale>0.495 0.495 0.495</scale></mesh></geometry></visual>
      </link>
    </model>

    <!-- Static obstacle: scanned clay long-tom pot with ornamental grass. Collision r 0.10 h 0.30. -->
    <model name="Static_Cylinder_06">
      <static>true</static>
      <pose>-0.298494 0.0224001 0.15 0 0 -0.690183</pose>
      <link name="link">
        <collision name="Static_Cylinder_06_collision"><pose>0 0 0 0 0 0</pose><geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry><surface><contact><collide_bitmask>0x01</collide_bitmask></contact></surface></collision>
        <visual name="pot"><pose>0.00082735 0.00939883 -0.150544 1.5708 0 0</pose><geometry><mesh><uri>garden/assets/external/polyhaven/planter_pot_clay/planter_pot_clay.gltf</uri><scale>0.820951 1.35214 0.820951</scale></mesh></geometry></visual>
        <visual name="soil"><pose>0 0 -0.15 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><mesh><uri>garden/assets/meshes/soil_disc.obj</uri><scale>1.05 1.05 1</scale></mesh></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.06 0.06 0.06 1</specular><pbr><metal><roughness>1.0</roughness><metalness>0.0</metalness><albedo_map>garden/assets/external/polyhaven/farm_soil/farm_soil_albedo.jpg</albedo_map><normal_map>garden/assets/external/polyhaven/farm_soil/farm_soil_normal.jpg</normal_map><roughness_map>garden/assets/external/polyhaven/farm_soil/farm_soil_roughness.jpg</roughness_map></metal></pbr></material></visual>
        <visual name="grass"><pose>0 0 -0.15 0 0 0</pose><geometry><mesh><uri>garden/assets/meshes/grass_tuft.obj</uri></mesh></geometry><material><ambient>0.42 0.5 0.22 1</ambient><diffuse>0.42 0.5 0.22 1</diffuse><specular>0.06 0.06 0.06 1</specular><double_sided>true</double_sided><pbr><metal><roughness>0.8</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link>
    </model>

    <!-- Static obstacle: half-barrel planter with marigolds. Collision r 0.10 h 0.30. -->
    <model name="Static_Cylinder_07">
      <static>true</static>
