  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <topic>/AGV/lidar/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>

      <lidar>
        <scan>
          <horizontal>
            <samples>2000</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.005</min>
          <max>15.0</max>
          <resolution>0.001</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

    <link name="camera_link">

    </link>

    <joint name="camera_joint" type="fixed">
      <parent link="lidar_link"/>
      <child link="camera_link"/>
      <!-- Temporary offset: 3 cm above the LiDAR frame -->
      <origin xyz="0 0.01 0.014" rpy="0 0.5236 0"/>
    </joint>

    <gazebo reference="camera_link">
      <sensor name="rgb_camera" type="camera">
        <topic>/AGV/camera/image_raw</topic>
        <gz_frame_id>camera_link</gz_frame_id>

        <update_rate>50</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>

        <camera>
          <horizontal_fov>1.78</horizontal_fov>
          <vertical_fov>1.169</vertical_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
    <gazebo>
      <plugin
          filename="gz-sim-ackermann-steering-system"
          name="gz::sim::systems::AckermannSteering">

        <!-- Rear driven wheels -->
        <left_joint>joint_BL</left_joint>
        <right_joint>joint_BR</right_joint>

        <!-- Front steering joints -->
        <left_steering_joint>joint_steeringknuckle_left</left_steering_joint>
        <right_steering_joint>joint_steeringknuckle_right</right_steering_joint>

        <!-- Vehicle dimensions -->
        <wheel_base>0.1046</wheel_base>
        <wheel_separation>0.181</wheel_separation>
        <kingpin_width>0.1137</kingpin_width>
        <wheel_radius>0.034</wheel_radius>

        <steering_limit>0.5</steering_limit>
        <!-- Gazebo applies these limits to BOTH m/s and rad/s. -->
        <min_velocity>-1.5</min_velocity>
        <max_velocity>1.5</max_velocity>

        <topic>/AGV/cmd_vel</topic>
        <!-- Wheel odometry of this plugin drifts (heading error), so it is
             moved out of the way; /AGV/odometry comes from the plugin below. -->
        <odom_topic>/AGV/wheel_odometry</odom_topic>
      </plugin>
    </gazebo>

    <!-- Odometry from the simulator's true motion (no drift). -->
    <gazebo>
      <plugin
          filename="gz-sim-odometry-publisher-system"
          name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_topic>/AGV/odometry</odom_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
        <dimensions>2</dimensions>
      </plugin>
    </gazebo>
    
    

</robot>






